# ── Required ──────────────────────────────────────────────────────────────────
# Get your free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any random string — signs JWT auth tokens
JWT_SECRET=change-this-to-a-random-secret-string

# ── Model defaults ─────────────────────────────────────────────────────────────
HF_MODEL_ID=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Pipeline tuning ───────────────────────────────────────────────────────────
MAX_ITERATIONS=3
QUALITY_THRESHOLD=0.85

# ── Search ─────────────────────────────────────────────────────────────────────
# Tavily: free at https://app.tavily.com — no card required
# Falls back to DuckDuckGo if not set
TAVILY_API_KEY=

# ── OpenRouter (optional — adds 5 more free models as fallback) ───────────────
# Free at https://openrouter.ai — no card required
OPENROUTER_API_KEY=

# ── CORS (optional) ────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to * for local dev.
# CORS_ORIGINS=https://yourapp.com,http://localhost:3000

# ── MCP — Brave Search (optional) ─────────────────────────────────────────────
# Brave requires a card. Skip it — Tavily + DDG cover the search needs.
# BRAVE_API_KEY=

# ── LangSmith observability (optional) ────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=neuroresearch

# ── Langfuse observability (optional) ─────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Eval output ───────────────────────────────────────────────────────────────
EVAL_OUTPUT_DIR=data/eval_results
