# ── Required ──────────────────────────────────────────────────────────────────
# Get your free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any random string — signs JWT auth tokens
JWT_SECRET=change-this-to-a-random-secret-string

# ── Model default ─────────────────────────────────────────────────────────────
# Must match one of the 5 model IDs in src/tools/llm.py
HF_MODEL_ID=llama-3.3-70b-versatile

# ── Pipeline tuning ───────────────────────────────────────────────────────────
MAX_ITERATIONS=3
QUALITY_THRESHOLD=0.95

# ── LangSmith observability (optional) ────────────────────────────────────────
# Get your key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=neuroresearch

# ── Langfuse observability (optional) ─────────────────────────────────────────
# Get keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Eval output ───────────────────────────────────────────────────────────────
EVAL_OUTPUT_DIR=data/eval_results
