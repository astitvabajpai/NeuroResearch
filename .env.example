# ── Required ──────────────────────────────────────────────────────────────────
# Get your free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_token_here

# Any random string — signs JWT auth tokens
JWT_SECRET=change-this-to-a-random-secret-string

# ── Optional model defaults ───────────────────────────────────────────────────
HF_MODEL_ID=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Groq (fast, free tier — try this first) ───────────────────────────────────
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Pipeline tuning ───────────────────────────────────────────────────────────
MAX_ITERATIONS=3
QUALITY_THRESHOLD=0.8

# ── MCP — Phase 1 ─────────────────────────────────────────────────────────────
# Option A (recommended): Use the bundled Arxiv MCP server.
# Spawns as a subprocess automatically — no external server needed.
MCP_USE_BUNDLED_ARXIV=true

# Option B: Point to an external MCP server (SSE transport).
# Overrides Option A when set. Examples:
#   GitHub MCP:     npx @modelcontextprotocol/server-github
#   Filesystem MCP: npx @modelcontextprotocol/server-filesystem .
MCP_SERVER_URLS=

# ── LangSmith observability (optional) ────────────────────────────────────────
# Get your key at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=neuroresearch
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Langfuse observability (optional, self-hostable) ──────────────────────────
# Get keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Eval harness output ───────────────────────────────────────────────────────
EVAL_OUTPUT_DIR=data/eval_results
